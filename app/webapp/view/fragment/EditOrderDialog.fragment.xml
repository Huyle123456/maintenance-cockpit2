<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:l="sap.ui.layout">
    <Dialog id="editOrderDialog" title="{i18n>orderDetailEditTitle} {orderDetail>/order}" contentWidth="700px">
        <l:Grid id="gridEditOrder" defaultSpan="XL6 L6 M6 S12" class="sapUiSmallMargin">
            <VBox id="vbEditOrderPlanner">
                <Label id="lblEditOrderPlanner" text="{i18n>orderDetailPlanner}" />
                <Select id="selEditOrderPlanner" selectedKey="{editOrder>/planner}" items="{masterData>/planners}" width="100%">
                    <core:Item id="itemEditOrderPlanner" key="{masterData>key}" text="{masterData>text}" />
                </Select>
            </VBox>
            <VBox id="vbEditOrderPriority">
                <Label id="lblEditOrderPriority" text="{i18n>orderDetailPriority}" />
                <Select id="selEditOrderPriority" selectedKey="{editOrder>/priority}" items="{masterData>/priorities}" width="100%">
                    <core:Item id="itemEditOrderPriority" key="{masterData>key}" text="{masterData>text}" />
                </Select>
            </VBox>
            <VBox id="vbEditOrderScheduledStart">
                <Label id="lblEditOrderScheduledStart" text="{i18n>orderDetailScheduledStart}" />
                <DatePicker id="dpEditOrderScheduledStart" value="{editOrder>/scheduledFrom}" valueFormat="MM/dd/yyyy" displayFormat="MM/dd/yyyy" width="100%" />
            </VBox>
            <VBox id="vbEditOrderScheduledEnd">
                <Label id="lblEditOrderScheduledEnd" text="{i18n>orderDetailScheduledEnd}" />
                <DatePicker id="dpEditOrderScheduledEnd" value="{editOrder>/scheduledTo}" valueFormat="MM/dd/yyyy" displayFormat="MM/dd/yyyy" width="100%" />
            </VBox>
        </l:Grid>
        <buttons>
            <Button id="btnEditOrderCancel" text="{i18n>commonCancel}" press=".onCancelEditOrder" />
            <Button id="btnEditOrderSave" text="{i18n>commonSave}" type="Emphasized" press=".onConfirmEditOrder" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
