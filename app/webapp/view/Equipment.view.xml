<mvc:View
    controllerName="com.fsoft.zpmmaintenancecockpit.controller.Equipment"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:card="sap.f.cards"
    displayBlock="true"
>
    <f:FlexibleColumnLayout
        id="equipmentFcl"
        layout="{ui>/layout}"
        backgroundDesign="Translucent"
        autoFocus="false"
        restoreFocusOnBackNavigation="true"
    >
        <f:beginColumnPages>
            <Page
                id="equipmentListPage"
                showHeader="false"
                enableScrolling="false"
                contentOnlyBusy="false"
            >
                <content>
                    <f:DynamicPage
                        id="equipmentDynamicPage"
                        showFooter="false"
                        toggleHeaderOnTitleClick="false"
                    >
                        <f:title>
                            <f:DynamicPageTitle id="equipmentPageTitle">
                                <f:heading>
                                    <Title
                                        id="equipmentPageHeading"
                                        text="{i18n>equipmentPageTitle}"
                                        level="H1"
                                    />
                                </f:heading>
                            </f:DynamicPageTitle>
                        </f:title>

                        <f:content>
                            <f:Card
                                id="equipmentsTableCard"
                                class="tableCard sapUiSmallMarginTop sapUiLargeMarginBottom"
                            >
                                <f:header>
                                    <card:Header
                                        title="{i18n>equipmenTableHeaderTitle}"
                                        level="H2"
                                    />
                                </f:header>
                                <f:content>
                                    <ScrollContainer
                                        id="equipmentTableScrollContainer"
                                        horizontal="true"
                                        vertical="false"
                                    >
                                        <Table
                                            id="equipmentTable"
                                            inset="false"
                                            items="{equipment>/equipment}"
                                            selectionChange="onRowPress"
                                        >
                                            <columns>
                                                <Column
                                                    id="colEquipmentId"
                                                    width="140px"
                                                >
                                                    <Text
                                                        id="equipmentColumnHeader"
                                                        text="{i18n>equipmentTableColEquipment}"
                                                    />
                                                </Column>
                                                <Column
                                                    id="colDescription"
                                                    width="240px"
                                                >
                                                    <Text
                                                        id="descriptionColumnHeader"
                                                        text="{i18n>equipmentTableColDescription}"
                                                    />
                                                </Column>
                                                <Column
                                                    id="colType"
                                                    width="130px"
                                                >
                                                    <Text
                                                        id="typeColumnHeader"
                                                        text="{i18n>equipmentTableColType}"
                                                    />
                                                </Column>
                                                <Column
                                                    id="colPlant"
                                                    width="100px"
                                                >
                                                    <Text
                                                        id="plantColumnHeader"
                                                        text="{i18n>equipmentTableColPlant}"
                                                    />
                                                </Column>
                                                <Column
                                                    id="colLocation"
                                                    width="140px"
                                                >
                                                    <Text
                                                        id="locationColumnHeader"
                                                        text="{i18n>equipmentTableColLocation}"
                                                    />
                                                </Column>
                                                <Column
                                                    id="colStatus"
                                                    width="140px"
                                                >
                                                    <Text
                                                        id="statusColumnHeader"
                                                        text="{i18n>equipmentTableColStatus}"
                                                    />
                                                </Column>
                                                <Column
                                                    id="colCriticality"
                                                    width="120px"
                                                >
                                                    <Text
                                                        id="criticalityColumnHeader"
                                                        text="{i18n>equipmentTableColCriticality}"
                                                    />
                                                </Column>
                                            </columns>

                                            <items>
                                                <ColumnListItem
                                                    id="equipmentRowTemplate"
                                                    type="Navigation"
                                                    press="onRowPress"
                                                >
                                                    <cells>
                                                        <Link
                                                            id="equipmentCellLink"
                                                            text="{equipment>equipment}"
                                                            press="onRowPress"
                                                        />
                                                        <Text
                                                            id="descriptionCellText"
                                                            text="{equipment>description}"
                                                        />
                                                        <Text
                                                            id="typeCellText"
                                                            text="{equipment>type}"
                                                        />
                                                        <Text
                                                            id="plantCellText"
                                                            text="{equipment>plant}"
                                                        />
                                                        <Text
                                                            id="locationCellText"
                                                            text="{equipment>location}"
                                                        />
                                                        <ObjectStatus
                                                            id="statusCellObjectStatus"
                                                            text="{equipment>status}"
                                                            state="{ path: 'equipment>status', formatter: '.formatter.formatStatusState' }"
                                                        />
                                                        <Text
                                                            id="criticalityCellText"
                                                            text="{equipment>criticality}"
                                                        />
                                                    </cells>
                                                </ColumnListItem>
                                            </items>
                                        </Table>
                                    </ScrollContainer>
                                </f:content>
                            </f:Card>
                        </f:content>
                    </f:DynamicPage>
                </content>
            </Page>
        </f:beginColumnPages>

        <f:midColumnPages>
            <Page
                id="equipmentDetailPage"
                showHeader="false"
                enableScrolling="false"
                contentOnlyBusy="false"
                class="equipmentDetailPage"
            >
                <content>
                    <core:Fragment
                        fragmentName="com.fsoft.zpmmaintenancecockpit.view.fragment.EquipmentDetails"
                        type="XML"
                    />
                </content>
            </Page>
        </f:midColumnPages>
    </f:FlexibleColumnLayout>
</mvc:View>
