<mvc:View
    controllerName="com.fsoft.zpmmaintenancecockpit.controller.MainLayout"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    height="100%"
    displayBlock="true"
>
    <tnt:ToolPage
        id="toolPage"
        sideExpanded="{= !${device>/system/phone} }"
    >
        <!-- Header -->
        <tnt:header id="mainLayoutTntHeader">
            <tnt:ToolHeader
                id="toolHeader"
                class="maintenanceHeader"
                height="3.5rem"
            >
                <!-- Hamburger button: toggle sidebar on all devices -->
                <Button
                    id="btnToggleSidebar"
                    icon="sap-icon://menu2"
                    type="Emphasized"
                    visible="{device>/system/phone}"
                    press=".onToggleSidebar"
                    tooltip="{i18n>mainLayoutToggleNavTooltip}"
                />

                <HBox
                    id="headerTitleContainer"
                    alignItems="Center"
                    class="sapUiTinyMarginTopBottom"
                >
                    <Title
                        id="appHeaderTitle"
                        text="{i18n>mainLayoutHeaderTitle}"
                        titleStyle="H3"
                        class="appHeaderTitle"
                    />

                    <Text
                        id="appHeaderSubtitle"
                        text="{i18n>mainLayoutHeaderSubtitle}"
                        class="sapUiFontSmall sapUiSmallMarginBegin"
                        visible="{= !${device>/system/phone} }"
                    />
                </HBox>

                <ToolbarSpacer id="headerToolbarSpacer" />

                <HBox
                    id="headerUserArea"
                    class="sapUiTinyMarginTopBottom"
                    alignItems="Center"
                >
                    <!-- User name and Role badge -->
                    <HBox
                        id="headerUserInfoBox"
                        alignItems="Center"
                        class="sapUiSmallMarginEnd"
                        visible="{= !${device>/system/phone} }"
                    >
                        <Text
                            id="headerUserText"
                            text="{auth>/currentUser/name}"
                            class="sapUiSmallMarginEnd"
                        />
                        <ObjectStatus
                            id="headerUserRoleBadge"
                            text="{auth>/currentUser/roleText}"
                            state="{= ${auth>/currentUser/isAdmin} ? 'Success' : 'Information' }"
                            inverted="true"
                        />
                    </HBox>

                    <Avatar
                        id="headerUserAvatar"
                        initials="{auth>/currentUser/avatarInitials}"
                        backgroundColor="{auth>/currentUser/avatarColor}"
                        displaySize="S"
                        showBorder="false"
                        tooltip="{i18n>userProfileTooltip}"
                        class="sapUiTinyMarginBegin"
                        press=".onUserAvatarPress"
                    />
                </HBox>
            </tnt:ToolHeader>
        </tnt:header>

        <!-- Side navigation: automatically collapsed on phones -->
        <tnt:sideContent>
            <tnt:SideNavigation
                id="sideNavigation"
                expanded="{= !${device>/system/phone} }"
                itemPress=".onItemPress"
            >
                <tnt:NavigationList id="mainNavigationList">
                    <!-- Maintenance Orders -->
                    <tnt:NavigationListItem
                        id="navItemOrders"
                        text="{i18n>mainLayoutNavOrders}"
                        key="orders"
                        icon="sap-icon://wrench"
                    />

                    <!-- Operations Dashboard -->
                    <tnt:NavigationListItem
                        id="navItemOperations"
                        text="{i18n>mainLayoutNavOperationsDashboard}"
                        key="operations"
                        icon="sap-icon://calendar"
                    />

                    <!-- Equipment -->
                    <tnt:NavigationListItem
                        id="navItemEquipment"
                        text="{i18n>mainLayoutNavEquipment}"
                        key="equipment"
                        icon="sap-icon://machine"
                    />

                    <!-- Technicians -->
                    <tnt:NavigationListItem
                        id="navItemTechnicians"
                        text="{i18n>mainLayoutNavTechnicians}"
                        key="technicians"
                        icon="sap-icon://employee"
                    />

                    <!-- Audit & History -->
                    <tnt:NavigationListItem
                        id="navItemAuditHistory"
                        text="{i18n>mainLayoutNavAuditHistory}"
                        key="auditHistory"
                        icon="sap-icon://history"
                    />

                    <!-- Challenge -->
                    <tnt:NavigationListGroup
                        id="navGroupChallenge"
                        text="{i18n>mainLayoutNavChallengeGroup}"
                    >
                        <!-- Process & Rules -->
                        <tnt:NavigationListItem
                            id="navItemProcessRules"
                            text="{i18n>mainLayoutNavProcessRules}"
                            key="processRules"
                            icon="sap-icon://information"
                        />
                    </tnt:NavigationListGroup>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <!-- Main content area -->
        <tnt:mainContents id="mainLayoutTntMainContents">
            <App id="mainLayoutApp" />
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
